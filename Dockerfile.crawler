FROM mcr.microsoft.com/playwright/python:v1.63.0-noble

WORKDIR /site

RUN apt-get update && apt-get install -y --no-install-recommends \
    ruby-full build-essential libffi-dev libyaml-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ENV BUNDLE_PATH=/opt/bundle
COPY Gemfile Gemfile.lock ./
RUN gem install bundler -v 2.4.19 --no-document && bundle install --jobs 4 --retry 3

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/ /site/scripts/

CMD ["/bin/bash", "/site/scripts/run_daily_crawler.sh"]
